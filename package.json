{
  "name": "suura",
  "productName": "Suura",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop music player for local files and YouTube links, with optional saving into the library.",
  "author": "alphaq0099",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "icon": "pwsh -NoProfile -File tools/make-icon.ps1",
  "publish:r2": "pwsh -NoProfile -File tools/publish-r2.ps1",
    "package:dir": "npm run build && electron-builder --dir --win",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "smoke": "tsx --tsconfig tsconfig.node.json tools/smoke.ts",
    "runtime:check": "electron tools/runtime-check.cjs",
    "selftest": "electron . --selftest",
    "scale": "electron . --scale",
    "perf": "npm run build && electron . --perf",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.11",
    "music-metadata": "^12.2.1",
    "node-id3": "^0.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
